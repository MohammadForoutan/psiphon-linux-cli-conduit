{
  "name": "psiphon-linux-cli",
  "version": "1.0.0",
  "description": "Unofficial Psiphon VPN client — CLI for Linux and Windows (connect, disconnect, stats)",
  "main": "cli/index.js",
  "bin": {
    "psiphon-cli": "cli/index.js",
    "psiphon": "cli/index.js"
  },
  "scripts": {
    "start": "node cli/index.js connect",
    "cli": "node cli/index.js",
    "connect": "node cli/index.js connect",
    "disconnect": "node cli/index.js disconnect",
    "stats": "node cli/index.js stats",
    "build": "pkg cli/index.js --targets node18-linux-x64 --output dist/psiphon-cli --config package.json",
    "build:win": "pkg cli/index.js --targets node18-windows-x64 --output dist/psiphon-cli.exe --config package.json"
  },
  "keywords": [
    "psiphon",
    "vpn",
    "cli",
    "conduit",
    "linux",
    "windows",
    "proxy",
    "tunnel"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MohammadForoutan/psiphon-linux-cli-conduit.git"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "cli/",
    "configs/"
  ],
  "pkg": {
    "assets": [
      "configs/**/*",
      "psiphon-tunnel-core-x86_64",
      "psiphon-tunnel-core-windows-amd64.exe",
      "psiphon-tunnel-core-i686.exe",
    ]
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
