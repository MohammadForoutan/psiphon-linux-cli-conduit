{
  "name": "psiphon-linux-cli",
  "version": "1.3.0",
  "description": "Unofficial Psiphon VPN client — CLI for Linux and Windows (connect, disconnect, stats)",
  "main": "cli/index.js",
  "bin": {
    "psiphon-cli": "cli/index.js",
    "psiphon": "cli/index.js"
  },
  "scripts": {
    "start": "node cli/index.js connect",
    "cli": "node cli/index.js",
    "connect": "node cli/index.js connect",
    "logs": "node cli/index.js logs",
    "disconnect": "node cli/index.js disconnect",
    "stats": "node cli/index.js stats",
    "prebuild": "node scripts/generate-version.js && node scripts/bundle-server-list.js",
    "build": "pkg cli/index.js --targets node18-linux-x64 --output dist/psiphon-cli --config package.json",
    "prebuild:win": "node scripts/generate-version.js && node scripts/bundle-server-list.js",
    "build:win": "pkg cli/index.js --targets node18-windows-x64 --output dist/psiphon-cli.exe --config package.json",
    "bundle-server-list": "node scripts/bundle-server-list.js",
    "download-server-list": "node scripts/download-server-list.js",
    "download-sing-box": "node scripts/download-sing-box.js",
    "prepare:rpm": "node scripts/download-server-list.js && node scripts/download-sing-box.js",
    "build:gui": "bash scripts/package-gui.sh",
    "package:gui": "bash scripts/package-gui.sh",
    "build:gui:rpm": "bash scripts/build-gui-rpm.sh",
    "build:gui:rpm:offline": "bash scripts/build-gui-rpm.sh --offline",
    "build:all": "npm run build && npm run build:gui"
  },
  "keywords": [
    "psiphon",
    "vpn",
    "cli",
    "conduit",
    "linux",
    "windows",
    "proxy",
    "tunnel"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MohammadForoutan/psiphon-linux-cli-conduit.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "cli/",
    "configs/"
  ],
  "pkg": {
    "assets": [
      "cli/version.generated.json",
      "configs/**/*",
      "psiphon-tunnel-core-x86_64",
      "psiphon-tunnel-core-windows-amd64.exe",
      "psiphon-tunnel-core-i686.exe"
    ]
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
